{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecMetadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "phase",
    "dependencies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "blocked",
        "in_progress",
        "done",
        "future",
        "cancelled"
      ]
    },
    "phase": {
      "type": [
        "integer",
        "string"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SPEC-[0-9]{3}$"
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4}$"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+\\.md$"
      }
    }
  },
  "additionalProperties": false
}
