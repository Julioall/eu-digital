{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cognitive Output Schema",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["silence", "question", "requested_response", "proactive_suggestion"]
    },
    "rendered_text": {
      "type": "string",
      "description": "The natural language text generated for the avatar to present."
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata like references used."
    }
  },
  "required": ["intent", "rendered_text"]
}