<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="EuDigital.Runtime"
    Publisher="CN=EuDigital"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Eu Digital Runtime</DisplayName>
    <PublisherDisplayName>Eu Digital Lab</PublisherDisplayName>
    <Description>Local cognitive agent runtime for Windows 11</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="pt-BR" />
  </Resources>

  <Applications>
    <Application
      Id="EuDigitalRuntimeApp"
      Executable="eu_digital_runtime.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Eu Digital"
        Description="Eu Digital Desktop Agent"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.startupTask" Executable="eu_digital_runtime.exe" EntryPoint="Windows.FullTrustApplication">
          <uap:StartupTask TaskId="EuDigitalStartup" Enabled="true" DisplayName="Eu Digital Background Agent" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
    <!-- Local file system access is handled through runFullTrust and explicit consent -->
  </Capabilities>

</Package>
