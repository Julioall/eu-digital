{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eu-digital:contracts:cognitive-state-bundle:1.0",
  "title": "CognitiveStateBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinator", "required_provider_ids", "fragments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_id", "seen_event_ids"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "policy_id": {"type": "string", "minLength": 1},
        "seen_event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "required_provider_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "provider_id", "state_schema_version", "entries"],
        "properties": {
          "schema_version": {"const": "1.0"},
          "provider_id": {"type": "string", "minLength": 1},
          "state_schema_version": {"type": "string", "minLength": 1},
          "entries": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
        }
      }
    }
  }
}
