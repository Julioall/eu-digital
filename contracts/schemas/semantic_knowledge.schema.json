{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticKnowledge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "knowledge_id", "concept", "source_episode_ids", "support_count", "confidence", "version", "alternatives", "contradictions", "created_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "knowledge_id": {"type": "string", "minLength": 1},
    "concept": {"type": "string", "minLength": 1},
    "source_episode_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "support_count": {"type": "integer", "minimum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "version": {"type": "integer", "minimum": 1},
    "alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contradictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "minLength": 1}
  }
}
