{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eu-digital:contracts:cognitive-decision-request:1.0",
  "title": "CognitiveDecisionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "hypothesis_id", "confidence", "information_gain", "evidence_ids", "reason", "workspace_snapshot_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "information_gain": {"type": "number", "minimum": 0},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "reason": {"type": "string", "minLength": 1},
    "workspace_snapshot_id": {"type": ["string", "null"], "minLength": 1}
  }
}
