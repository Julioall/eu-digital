{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservedPattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pattern_id",
    "schema_version",
    "version",
    "status",
    "centroid",
    "support",
    "stability",
    "recency",
    "confidence",
    "observation_refs",
    "feedback",
    "parent_pattern_id",
    "drift_reason",
    "created_by"
  ],
  "properties": {
    "pattern_id": {"type": "string"},
    "schema_version": {"type": "string", "const": "1.0"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["candidate", "promoted", "superseded"]},
    "centroid": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "support": {"type": "integer", "minimum": 0},
    "stability": {"type": "number", "minimum": 0, "maximum": 1},
    "recency": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "observation_refs": {"type": "array", "items": {"type": "string"}},
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative", "references"],
      "properties": {
        "positive": {"type": "integer", "minimum": 0},
        "negative": {"type": "integer", "minimum": 0},
        "references": {"type": "array", "items": {"type": "string"}}
      }
    },
    "parent_pattern_id": {"type": ["string", "null"]},
    "drift_reason": {"type": ["string", "null"]},
    "created_by": {"type": "string", "minLength": 1}
  }
}
