{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "runtime_version",
    "build",
    "contract_versions",
    "promoted_components",
    "optional_capabilities"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "runtime_id": {"type": "string", "minLength": 1},
    "runtime_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "compiler", "profile", "commit", "python_runtime_dependency"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "compiler": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "enum": ["Debug", "RelWithDebInfo", "Release"]},
        "commit": {"type": "string", "minLength": 1},
        "python_runtime_dependency": {"type": "boolean", "const": false}
      }
    },
    "contract_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "promoted_components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "promotion_id", "version"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "promotion_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "optional_capabilities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
