{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionSimulation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_digest", "effects", "risk_summary", "reversible", "processing_cost_ms"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "minLength": 1},
    "effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risk_summary": {"type": "string", "minLength": 1},
    "reversible": {"type": "boolean"},
    "processing_cost_ms": {"type": "number", "minimum": 0}
  }
}
