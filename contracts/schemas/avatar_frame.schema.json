{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eu-digital:avatar-frame:1",
  "title": "ProceduralAvatarFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "model_required",
    "width",
    "height",
    "rendered",
    "reason",
    "pixel_count",
    "nonzero_pixel_count",
    "pixels_sha256",
    "blocks_work",
    "captures_input",
    "has_focus"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "source": {"type": "string", "const": "procedural"},
    "model_required": {"type": "boolean", "const": false},
    "width": {"type": "integer", "minimum": 1, "maximum": 1024},
    "height": {"type": "integer", "minimum": 1, "maximum": 1024},
    "rendered": {"type": "boolean"},
    "reason": {"type": "string", "enum": ["rendered", "view_hidden", "consent_required", "globally_paused", "quota_exhausted"]},
    "pixel_count": {"type": "integer", "minimum": 0},
    "nonzero_pixel_count": {"type": "integer", "minimum": 0},
    "pixels_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "blocks_work": {"type": "boolean", "const": false},
    "captures_input": {"type": "boolean", "const": false},
    "has_focus": {"type": "boolean", "const": false}
  }
}
