{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eu-digital:contracts:cognitive-cycle-input:1.0",
  "title": "CognitiveCycleInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "event_id", "source", "event_type", "session_id", "occurred_at", "epoch_seconds", "modality", "application", "document", "content", "numeric_features", "salience_signals", "causation_chain", "time_basis", "replay_mode"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "correlation_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "minLength": 1},
    "epoch_seconds": {"type": "number"},
    "modality": {"type": "string", "minLength": 1},
    "application": {"type": ["string", "null"], "minLength": 1},
    "document": {"type": ["string", "null"], "minLength": 1},
    "content": {"type": "object", "additionalProperties": {"type": "string"}},
    "numeric_features": {"type": "object", "additionalProperties": {"type": "number"}},
    "salience_signals": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "causation_chain": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "time_basis": {"type": "string", "enum": ["source_occurred", "received_fallback"]},
    "replay_mode": {"type": "boolean"}
  }
}
