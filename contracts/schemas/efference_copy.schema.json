{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EfferenceCopy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "copy_id", "action_id", "issued_at", "expected_effects", "observation_window_ms", "control_id"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "copy_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "minLength": 1},
    "expected_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "observation_window_ms": {"type": "integer", "minimum": 1},
    "control_id": {"type": "string", "minLength": 1}
  }
}
