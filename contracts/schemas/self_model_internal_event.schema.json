{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelfModelInternalEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "occurred_at",
    "kind",
    "reason",
    "source_event_ids",
    "capability",
    "assertion"
  ],
  "$defs": {
    "capability": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["capability_id", "status", "explanation"],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["available", "degraded", "unavailable", "removed"]
        },
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "assertion": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "subject",
        "predicate",
        "value",
        "classification",
        "explanation"
      ],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "classification": {
          "type": "string",
          "enum": ["fact", "hypothesis", "configuration"]
        },
        "explanation": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0"},
    "occurred_at": {"type": "string", "minLength": 1},
    "kind": {
      "type": "string",
      "enum": ["capability_changed", "assertion_recorded"]
    },
    "reason": {"type": "string", "minLength": 1},
    "source_event_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "capability": {"$ref": "#/$defs/capability"},
    "assertion": {"$ref": "#/$defs/assertion"}
  }
}
