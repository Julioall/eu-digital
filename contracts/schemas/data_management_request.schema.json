{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataManagementRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation", "scope", "scope_value", "confirmed", "requested_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "enum": ["export", "delete"]},
    "scope": {"type": "string", "enum": ["all", "sensor", "purpose", "period"]},
    "scope_value": {"type": "string", "minLength": 1},
    "confirmed": {"type": "boolean"},
    "requested_at": {"type": "string", "minLength": 1}
  }
}
