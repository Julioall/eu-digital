{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConsolidationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "policy_id", "source_episode_ids", "knowledge_ids", "replayed_at", "processing_cost_ms"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "record_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "source_episode_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "knowledge_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "replayed_at": {"type": "string", "minLength": 1},
    "processing_cost_ms": {"type": "number", "minimum": 0}
  }
}
