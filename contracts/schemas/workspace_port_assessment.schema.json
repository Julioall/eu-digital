{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eu-digital:contracts:workspace-port-assessment:1.0",
  "title": "WorkspacePortAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "workspace_id", "session_id", "created_at", "capacity", "policy_id", "config_fingerprint", "selection_churn", "active_candidate_ids", "expired_candidate_ids", "discarded_candidate_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "capacity": {"type": "integer", "minimum": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "config_fingerprint": {"type": "string", "minLength": 1},
    "selection_churn": {"type": "number", "minimum": 0, "maximum": 1},
    "active_candidate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expired_candidate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "discarded_candidate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
