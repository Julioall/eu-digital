{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PredictionError",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prediction_id",
    "schema_version",
    "model_id",
    "observed_state",
    "log_loss",
    "top_k_hit",
    "salience_contribution",
    "confidence",
    "drift_id",
    "observed_at"
  ],
  "properties": {
    "prediction_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0"},
    "model_id": {"type": "string", "minLength": 1},
    "observed_state": {"type": "string", "minLength": 1},
    "log_loss": {"type": "number", "minimum": 0},
    "top_k_hit": {"type": "boolean"},
    "salience_contribution": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "drift_id": {"type": ["string", "null"]},
    "observed_at": {"type": "string", "minLength": 1}
  }
}
