{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesis_id",
    "schema_version",
    "kind",
    "statement",
    "status",
    "confidence",
    "evidence",
    "alternatives",
    "created_at",
    "updated_at",
    "verification",
    "provenance"
  ],
  "properties": {
    "hypothesis_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {
      "type": "string",
      "enum": ["observed_pattern", "causal", "predictive", "contextual", "capability"]
    },
    "statement": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["proposed", "confirmed", "rejected", "superseded"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supporting_refs", "opposing_refs"],
      "properties": {
        "supporting_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "opposing_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "expected_information_gain"],
      "properties": {
        "question": {"type": ["string", "null"]},
        "expected_information_gain": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "model_version"],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "model_version": {"type": ["string", "null"]}
      }
    }
  }
}
