{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DialogueNotice",
  "type": "object",
  "additionalProperties": false,
  "required": ["notice_id", "schema_version", "kind", "hypothesis_id", "confidence", "context_refs", "reason", "question", "created_at"],
  "properties": {
    "notice_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "enum": ["notification", "question"]},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "context_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reason": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  }
}
