{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AudioSegment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "segment_id",
    "start_timestamp_ms",
    "end_timestamp_ms",
    "audio_reference",
    "vad",
    "processing_cost_ms"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "segment_id": {"type": "string", "minLength": 1},
    "start_timestamp_ms": {"type": "integer", "minimum": 0},
    "end_timestamp_ms": {"type": "integer", "minimum": 0},
    "audio_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "content_hash", "duration_ms"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    },
    "vad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "speech_confidence"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "speech_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "processing_cost_ms": {"type": "number", "minimum": 0}
  }
}
