{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LongitudinalReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "schema_version", "study_id", "protocol_hash", "baseline_policy_id", "snapshots", "retention_curve", "calibration", "change_report", "self_model_drift"],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0"},
    "study_id": {"type": "string", "minLength": 1},
    "protocol_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_policy_id": {"type": "string", "const": "chronological_first_snapshot_v0"},
    "snapshots": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "retention_curve": {"type": "array", "items": {"type": "object"}},
    "calibration": {"type": "object"},
    "change_report": {"type": "object"},
    "self_model_drift": {"type": "object"}
  }
}
