{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgencyActionOutcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome_id", "action_id", "occurred_at", "observed_effects", "success", "observation_origin", "correlation_id"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "outcome_id": {"type": "string", "minLength": 1},
    "action_id": {"type": ["string", "null"]},
    "occurred_at": {"type": "string", "minLength": 1},
    "observed_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "success": {"type": "boolean"},
    "observation_origin": {"type": "string", "enum": ["unclassified", "explicit_external"]},
    "correlation_id": {"type": ["string", "null"]}
  }
}
