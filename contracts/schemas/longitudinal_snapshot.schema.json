{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LongitudinalSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "schema_version", "study_id", "checkpoint_day", "captured_at", "protocol_hash", "cognitive_metrics", "operational_metrics", "self_model_version", "self_model_digest", "source_refs"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0"},
    "study_id": {"type": "string", "minLength": 1},
    "checkpoint_day": {"type": "integer", "enum": [7, 30, 90]},
    "captured_at": {"type": "string", "minLength": 1},
    "protocol_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cognitive_metrics": {"type": "object", "additionalProperties": {"type": "number"}},
    "operational_metrics": {"type": "object", "additionalProperties": {"type": "number"}},
    "self_model_version": {"type": "integer", "minimum": 1},
    "self_model_digest": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
