{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "schema_version",
    "session_id",
    "source_kind",
    "source_refs",
    "observed_at",
    "content",
    "salience_signals"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "source_kind": {
      "type": "string",
      "enum": ["canonical_event", "episode", "pattern", "internal"]
    },
    "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "observed_at": {"type": "string", "minLength": 1},
    "content": {"type": "object"},
    "salience_signals": {"type": "object", "additionalProperties": {"type": "number"}}
  }
}
