{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgencyAttribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attribution_id", "action_id", "label", "confidence", "evidence", "prediction_error", "policy_id"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "attribution_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "enum": ["own", "external", "ambiguous"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prediction_error": {"type": "number", "minimum": 0},
    "policy_id": {"type": "string", "minLength": 1}
  }
}
