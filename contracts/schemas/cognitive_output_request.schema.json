{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eu-digital:contracts:cognitive-output-request:1.0",
  "title": "CognitiveOutputRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "correlation_id", "input_event_id", "intent", "occurred_at", "critical", "reason", "input_content", "self_model_id", "self_constraints", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "input_event_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "intent": {"type": "string", "enum": ["silence", "question", "requested_response", "proactive_suggestion"]},
    "occurred_at": {"type": "string", "minLength": 1, "maxLength": 128},
    "critical": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
    "input_content": {"type": "object", "maxProperties": 32, "propertyNames": {"minLength": 1, "maxLength": 128}, "additionalProperties": {"type": "string", "maxLength": 8192}},
    "self_model_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "self_constraints": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  },
  "allOf": [
    {"if": {"properties": {"intent": {"enum": ["question", "requested_response"]}}}, "then": {"properties": {"critical": {"const": true}}}},
    {"if": {"properties": {"intent": {"enum": ["silence", "proactive_suggestion"]}}}, "then": {"properties": {"critical": {"const": false}}}}
  ]
}
