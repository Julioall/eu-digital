{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetentionDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "episode_id", "action", "reason", "reversible", "prior_state", "occurred_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "decision_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "enum": ["retain", "archive", "restore"]},
    "reason": {"type": "string", "minLength": 1},
    "reversible": {"type": "boolean"},
    "prior_state": {"type": "string", "enum": ["active", "archived"]},
    "occurred_at": {"type": "string", "minLength": 1}
  }
}
